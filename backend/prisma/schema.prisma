generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model User {
  id              String   @id @default(uuid()) @db.VarChar(255)
  email           String   @unique @db.VarChar(255)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  firstName       String?  @map("first_name") @db.VarChar(100)
  lastName        String?  @map("last_name") @db.VarChar(100)
  avatarUrl       String?  @map("avatar_url") @db.Text
  location        String?  @db.VarChar(255)
  phone           String?  @db.VarChar(50)
  address         String?  @db.Text
  dateOfBirth     DateTime? @map("date_of_birth")
  role            String   @default("CLIENT") @db.VarChar(50) // ADMIN, HOST, CLIENT
  isBlocked       Boolean  @default(false) @map("is_blocked")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  hostProfile  HostProfile?
  tickets      Ticket[]
  transactions Transaction[]
  winners      Winner[]
  notifications Notification[]

  @@map("users")
  @@schema("app")
}

model HostProfile {
  id            String   @id @default(uuid()) @db.VarChar(255)
  userId        String   @unique @map("user_id") @db.VarChar(255)
  businessName  String   @map("business_name") @db.VarChar(255)
  slug          String?  @unique @db.VarChar(255)
  bio           String?  @db.Text
  phone         String?  @db.VarChar(50)
  address       String?  @db.Text
  walletBalance Decimal  @default(0.00) @map("wallet_balance") @db.Decimal(10, 2)
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User               @relation(fields: [userId], references: [id])
  subscriptions HostSubscription[]
  raffles       Raffle[]
  withdrawals   Withdrawal[]

  @@map("host_profiles")
  @@schema("app")
}

model SubscriptionPlan {
  id               String   @id @default(uuid()) @db.VarChar(255)
  name             String   @db.VarChar(100)
  price            Decimal  @db.Decimal(10, 2)
  durationDays     Int      @map("duration_days")
  maxActiveRaffles Int?     @map("max_active_raffles")
  createdAt        DateTime @default(now()) @map("created_at")

  subscriptions HostSubscription[]

  @@map("subscription_plans")
  @@schema("app")
}

model HostSubscription {
  id        String   @id @default(uuid()) @db.VarChar(255)
  hostId    String   @map("host_id") @db.VarChar(255)
  planId    String   @map("plan_id") @db.VarChar(255)
  status    String   @default("ACTIVE") @db.VarChar(50) // ACTIVE, EXPIRED, CANCELLED
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")

  host HostProfile      @relation(fields: [hostId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("host_subscriptions")
  @@schema("app")
}

model Raffle {
  id             String   @id @default(uuid()) @db.VarChar(255)
  hostId         String   @map("host_id") @db.VarChar(255)
  title          String   @db.VarChar(255)
  slug           String?  @unique @db.VarChar(255)
  category       String?  @db.VarChar(100)
  description    String?
  mainImage      String?  @map("main_image") @db.Text
  prizeName      String?  @map("prize_name") @db.VarChar(255)
  mainPrizeValue Decimal? @map("main_prize_value") @db.Decimal(10, 2)
  pricePerTicket Decimal  @map("price_per_ticket") @db.Decimal(10, 2)
  totalTickets   Int      @map("total_tickets")
  ticketsSold    Int      @default(0) @map("tickets_sold")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  status         String   @default("PENDING_APPROVAL") @db.VarChar(50) // DRAFT, PENDING_APPROVAL, ACTIVE, ENDED, CANCELLED
  
  // Draw Settings
  isAutoDraw      Boolean  @default(true) @map("is_auto_draw")
  autoDrawDate    Boolean  @default(true) @map("auto_draw_date")
  autoDrawSoldOut Boolean  @default(false) @map("auto_draw_sold_out")

  // Ticket limits per person
  minTickets      Int?     @default(1) @map("min_tickets")
  maxTickets      Int?     @map("max_tickets")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  host        HostProfile  @relation(fields: [hostId], references: [id])
  instantWins InstantWin[]
  tickets     Ticket[]
  winners     Winner[]

  @@map("raffles")
  @@schema("app")
}

model InstantWin {
  id           String   @id @default(uuid()) @db.VarChar(255)
  raffleId     String   @map("raffle_id") @db.VarChar(255)
  ticketNumber Int      @map("ticket_number")
  prizeName    String   @map("prize_name") @db.VarChar(255)
  rrpValue     Decimal? @map("rrp_value") @db.Decimal(10, 2)
  image        String?  @db.Text
  isClaimed    Boolean  @default(false) @map("is_claimed")
  createdAt    DateTime @default(now()) @map("created_at")

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@map("instant_wins")
  @@schema("app")
}

model Transaction {
  id                   String   @id @default(uuid()) @db.VarChar(255)
  userId               String   @map("user_id") @db.VarChar(255)
  type                 String   @db.VarChar(50) // TICKET_PURCHASE, SUBSCRIPTION_FEE, HOST_WITHDRAWAL
  amount               Decimal  @db.Decimal(10, 2)
  status               String   @default("COMPLETED") @db.VarChar(50) // PENDING, COMPLETED, FAILED, REFUNDED
  paymentGateway       String?  @map("payment_gateway") @db.VarChar(50) // STRIPE, PAYPAL
  gatewayTransactionId String?  @map("gateway_transaction_id") @db.VarChar(255)
  relatedEntityId      String?  @map("related_entity_id") @db.VarChar(255) // Polymorphic ID
  createdAt            DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  tickets Ticket[]

  @@map("transactions")
  @@schema("app")
}

model Ticket {
  id            String   @id @default(uuid()) @db.VarChar(255)
  raffleId      String   @map("raffle_id") @db.VarChar(255)
  userId        String   @map("user_id") @db.VarChar(255)
  transactionId String   @map("transaction_id") @db.VarChar(255)
  ticketNumber  Int      @map("ticket_number")
  createdAt     DateTime @default(now()) @map("created_at")

  raffle      Raffle      @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])
  winners     Winner[]

  @@map("tickets")
  @@schema("app")
}

model Winner {
  id             String   @id @default(uuid()) @db.VarChar(255)
  userId         String   @map("user_id") @db.VarChar(255)
  raffleId       String   @map("raffle_id") @db.VarChar(255)
  ticketId       String   @map("ticket_id") @db.VarChar(255)
  winType        String   @map("win_type") @db.VarChar(50) // MAIN_DRAW, INSTANT_WIN
  prizeName      String   @map("prize_name") @db.VarChar(255)
  deliveryStatus String   @default("PENDING") @map("delivery_status") @db.VarChar(50) // PENDING, SHIPPED, DELIVERED
  verificationStatus String @default("PENDING") @map("verification_status") @db.VarChar(50) // PENDING, VERIFIED, REJECTED
  isClaimed      Boolean  @default(false) @map("is_claimed")
  trackingNumber String?  @map("tracking_number") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("winners")
  @@schema("app")
}

model Withdrawal {
  id            String   @id @default(uuid()) @db.VarChar(255)
  hostId        String   @map("host_id") @db.VarChar(255)
  amount        Decimal  @db.Decimal(10, 2)
  feeAmount     Decimal? @default(0.00) @map("fee_amount") @db.Decimal(10, 2)
  netAmount     Decimal? @default(0.00) @map("net_amount") @db.Decimal(10, 2)
  status        String   @default("PENDING") @db.VarChar(50) // PENDING, APPROVED, REJECTED, COMPLETED
  adminNotes    String?  @map("admin_notes") @db.Text
  payoutMethod  String?  @map("payout_method") @db.VarChar(100) // BANK_TRANSFER, PAYPAL
  payoutDetails String?  @map("payout_details") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  host HostProfile @relation(fields: [hostId], references: [id])

  @@map("withdrawals")
  @@schema("app")
}

model Category {
  id          String   @id @default(uuid()) @db.VarChar(255)
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  icon        String?  @db.VarChar(50)
  image       String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("categories")
  @@schema("app")
}

model Notification {
  id        String    @id @default(uuid()) @db.VarChar(255)
  userId    String    @map("user_id") @db.VarChar(255)
  type      String    @db.VarChar(50) // "WIN", "INSTANT_WIN", "PURCHASE", "RAFFLE", "SYSTEM"
  title     String    @db.VarChar(255)
  message   String    @db.Text
  link      String?   @db.VarChar(500)
  metadata  Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
  @@schema("app")
}
